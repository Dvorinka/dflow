# mongodb
MONGO_INITDB_ROOT_USERNAME=admin
MONGO_INITDB_ROOT_PASSWORD=your-password
MONGO_DB_NAME=your-db-name

# config generator
WILD_CARD_DOMAIN=subdomain.example.com
JWT_TOKEN=your-jwt-token-here

# Application Base URL
NEXT_PUBLIC_WEBSITE_URL=http://localhost:3000

# Build version shown to clients for stale-build detection (e.g. git SHA).
# Set at build time: NEXT_PUBLIC_APP_VERSION=$(git rev-parse --short HEAD).
# Unset = version check stays silent.
NEXT_PUBLIC_APP_VERSION=dev

# Sibling domains for cross-app logout sync (#364), comma-separated.
# Unset = disabled. Only set this if you run the companion dFlow App.
NEXT_PUBLIC_AUTH_SYNC_DOMAINS=

# PostHog telemetry key (optional). Unset = telemetry stays off.
NEXT_PUBLIC_POSTHOG_KEY=

# Payload CMS secret key
PAYLOAD_SECRET=your-secret-key-here

# Database connection string
DATABASE_URI=mongodb://${MONGO_INITDB_ROOT_USERNAME}:${MONGO_INITDB_ROOT_PASSWORD}@mongodb:27017/${MONGO_DB_NAME}?authSource=admin

# Redis connection string
REDIS_URI=redis://redis:6379

# Server details cache TTL in seconds (default 300). Populated server
# reads fan out to SSH calls; the cache is bypassed on manual refresh
# and busted on server create/update/delete.
SERVER_DETAILS_CACHE_TTL=300

# Webhook URL for local testing (optional in production)
NEXT_PUBLIC_WEBHOOK_URL=https://your-ngrok-url.ngrok-free.app

# Authentication method override (optional).
# Unset = use the AuthConfig global in the admin UI.
# Set to email-password to disable magic links (e.g. no email provider),
# magic-link for passwordless-only, or both to allow either.
# Magic links additionally require Resend below; without it the app
# degrades to email-password automatically.
AUTH_METHOD=both

# Resend email service credentials
RESEND_API_KEY=your-resend-api-key
RESEND_SENDER_EMAIL=your-sender-email@example.com
RESEND_SENDER_NAME=Your Sender Name

# Better stack
NEXT_PUBLIC_BETTER_STACK_SOURCE_TOKEN=t6kv**************
NEXT_PUBLIC_BETTER_STACK_INGESTING_URL="https://s1*****.**-***-**.betterstackdata.com"

# Tailscale API Configuration
TAILSCALE_AUTH_KEY=tskey-auth-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TAILSCALE_OAUTH_CLIENT_SECRET=tskey-client-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TAILSCALE_TAILNET=your-tailnet-name

# Public URL for proxy access (used for frontend access and public links)
NEXT_PUBLIC_PROXY_DOMAIN_URL=up.example.com

# Internal DNS alias pointing to the proxy (used for DNS routing without exposing raw IPs)
NEXT_PUBLIC_PROXY_CNAME=cname.up.example.com

NEXT_PUBLIC_DISCORD_INVITE_URL=your-discord-invite-url

BESZEL_MONITORING_URL=
BESZEL_SUPERUSER_EMAIL=
BESZEL_SUPERUSER_PASSWORD=
BESZEL_HUB_SSHKEY=
